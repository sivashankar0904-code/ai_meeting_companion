# LLM
ANTHROPIC_API_KEY=
CONVERSOR_MODEL=claude-haiku-4-5-20251001
SCREEN_MODEL=claude-sonnet-5-5
CHAT_MODEL=claude-sonnet-5-5

# Database connection
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=postgres

# Connection pool sizing
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10

# Set false for local/plaintext Postgres
DB_SSL_REQUIRED=false

# App
# small.en is much more accurate than base.en on technical words (first run downloads ~460 MB)
WHISPER_MODEL=small.en
# auto = use the NVIDIA GPU when available (much faster), else CPU. Or force: cuda / cpu
WHISPER_DEVICE=auto
# Names/terms Whisper should spell correctly (space separated). Terms in your context/ files are picked up automatically.
WHISPER_HOTWORDS=
# Optional sentence describing the conversation, e.g. "A discussion about ..."
WHISPER_PROMPT=
# Learn spelling hints from your context files
WHISPER_AUTO_VOCAB=true
SCREENSHOT_HOTKEY=<ctrl>+<shift>+s
# Send what was heard to the Conversor for a suggested answer (nothing is sent to the model until you press this)
SUGGEST_HOTKEY=<ctrl>+<shift>+a
TESSERACT_CMD=
# Capture your own microphone (tagged "mic"); loopback (meeting audio) is always captured.
# Use headphones: on speakers the mic also picks up the meeting audio and it is transcribed twice.
AUDIO_MIC=true
# Which microphone: empty = Windows default, a number, or part of the name (see: ai-meeting-companion devices)
AUDIO_MIC_DEVICE=
AUDIO_CHUNK_SECS=6
# Folder with your resume / job description / notes (relative to the project root)
CONTEXT_DIR=context

# How much of the shared session history (heard / on screen / typed / earlier answers) goes with each
# request, in characters (~4 per token). Higher = better continuity, more tokens; 0 = none.
SESSION_MEMORY_CHARS=8000

# Overlay
OVERLAY_OPACITY=0.94
# Hide the overlay from screen capture / screen sharing (Windows 10 2004+)
OVERLAY_HIDE_FROM_CAPTURE=true
OVERLAY_TOGGLE_HOTKEY=<ctrl>+<shift>+h
OVERLAY_CLICKTHROUGH_HOTKEY=<ctrl>+<shift>+t
OVERLAY_FOCUS_HOTKEY=<ctrl>+<shift>+i
# The exe has no console, taskbar button or tray icon, so this is how you close it (or the Quit button)
OVERLAY_QUIT_HOTKEY=<ctrl>+<shift>+q
